# Port the API listens on inside its container.
PORT=3000

# PostgreSQL connection string. In local development this points at the
# Postgres container defined in the infrastructure repository.
DATABASE_URL=postgresql://modulo:modulo@localhost:5432/modulo_world_dev

# Salt used to hash visitor IP addresses before storage. Must be set to a
# long random value per environment, and must never be committed.
IP_HASH_SALT=change-me

# Auth0 - populated when authentication is implemented.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
