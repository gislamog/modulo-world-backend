# Port the API listens on inside its container.
PORT=3000

# PostgreSQL connection string, in the form:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Locally, USER, PASSWORD and DATABASE must match the values set in the
# infrastructure repository's .env, which is what creates the database.
# HOST is localhost while the API runs outside Docker, and the Compose
# service name once it runs inside.
DATABASE_URL=

# Salt used to hash visitor IP addresses before storage. Must be set to a
# long random value per environment, and must never be committed.
IP_HASH_SALT=change-me

# Auth0 - populated when authentication is implemented.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
