# Installed inside the image. Copying the host's copy would also carry
# binaries built for the wrong platform, and the generated Prisma client
# is one of them.
node_modules

# Build output, regenerated by the build stage.
dist
coverage
*.tsbuildinfo

# Never in an image.
.env
.env.*
!.env.example

.git
.github
resources-local-only

test

.vscode
.DS_Store
Thumbs.db

README.md
